# ==============================================================================
# WEBMAGIC ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this to .env and fill in your actual API keys.
# Never commit .env (it is git-ignored).
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_NAME=WebMagic
# true enables /docs, verbose errors and localhost CORS origins. Keep false in production.
DEBUG=false
API_VERSION=v1

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL 14+, e.g. local Postgres or Supabase)
# ------------------------------------------------------------------------------
# Required: Main database connection
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+asyncpg://your-user:your-password@your-host:5432/postgres

# Optional: Only if using Supabase client SDK features directly
# SUPABASE_PROJECT_URL=https://your-project.supabase.co
# SUPABASE_API_KEY=your-supabase-api-key

# ------------------------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------------------------
# Required: signs JWTs. Must be random and at least 32 chars (the app refuses weak values).
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ------------------------------------------------------------------------------
# REDIS (for Celery task queue)
# ------------------------------------------------------------------------------
# Optional: Defaults to localhost. For testing, tasks run synchronously without Redis.
# REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI SERVICES
# ------------------------------------------------------------------------------
# Required: Get from https://console.anthropic.com/
# Used by: Analyst, Concept, Art Director, Architect agents
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ------------------------------------------------------------------------------
# BUSINESS SCRAPING
# ------------------------------------------------------------------------------
# Required: Get from https://app.outscraper.com/
# Used by: Discovery Campaign to scrape businesses from Google Maps
OUTSCRAPER_API_KEY=your-outscraper-api-key-here

# ------------------------------------------------------------------------------
# IMAGE GENERATION (Google Gemini)
# ------------------------------------------------------------------------------
# Optional: Get from https://ai.google.dev/
# Used by: Architect agent to generate website images (hero, backgrounds, etc.)
GEMINI_API_KEY=your-gemini-api-key-here

# ------------------------------------------------------------------------------
# PAYMENTS (Recurrente)
# ------------------------------------------------------------------------------
# Required: Get from https://app.recurrente.com/
RECURRENTE_PUBLIC_KEY=your-recurrente-public-key-here
RECURRENTE_SECRET_KEY=your-recurrente-secret-key-here
# Svix signing secret (starts with whsec_). Webhooks are rejected while this is empty.
RECURRENTE_WEBHOOK_SECRET=
RECURRENTE_BASE_URL=https://app.recurrente.com

# ------------------------------------------------------------------------------
# EMAIL (Optional - for sending campaigns)
# ------------------------------------------------------------------------------
# Choose: "brevo" (recommended), "ses" (AWS), or "sendgrid"
EMAIL_PROVIDER=brevo
EMAIL_FROM=your-email@your-domain.com

# If using Brevo (recommended - 300 emails/day FREE):
# Get from: https://app.brevo.com/ → Settings → SMTP & API → API Keys
# BREVO_API_KEY=your-brevo-api-key

# If using AWS SES:
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# If using SendGrid:
# SENDGRID_API_KEY=your-sendgrid-api-key

# ------------------------------------------------------------------------------
# SMS / LabsMobile (primary provider)
# ------------------------------------------------------------------------------
# Required for SMS: Get from https://www.labsmobile.com/
# 1. Create account at labsmobile.com
# 2. Generate API token from: Account → API Settings
# 3. Configure webhook URLs in API Settings:
#    - Delivery status (GET): https://api.your-domain.com/api/v1/webhooks/labsmobile/status?token=<LABSMOBILE_WEBHOOK_TOKEN>
#    - Inbound replies (POST): https://api.your-domain.com/api/v1/webhooks/labsmobile/reply?token=<LABSMOBILE_WEBHOOK_TOKEN>

# LABSMOBILE_USERNAME=your-account@email.com
# LABSMOBILE_TOKEN=your-labsmobile-api-token
# LABSMOBILE_PHONE_NUMBER=+12345678900   # Optional sender number or alphanumeric ID (max 11 chars)
# LabsMobile doesn't sign callbacks, so they must carry this shared secret (openssl rand -hex 24).
# LABSMOBILE_WEBHOOK_TOKEN=

# SMS Settings
# SMS_PROVIDER=labsmobile
# API_URL=https://api.your-domain.com   # Used to build webhook callback URLs

# ------------------------------------------------------------------------------
# SMS / Telnyx (kept for rollback — not active when SMS_PROVIDER=labsmobile)
# ------------------------------------------------------------------------------
# TELNYX_API_KEY=KEY_your-telnyx-api-key
# TELNYX_PHONE_NUMBER=+12345678900
# TELNYX_MESSAGING_PROFILE_ID=your-messaging-profile-id
# TELNYX_PUBLIC_KEY=your-telnyx-webhook-public-key   # Required: Telnyx webhooks are signature-verified

# ------------------------------------------------------------------------------
# URLS / SITE HOSTING
# ------------------------------------------------------------------------------
# Admin dashboard + customer portal (also allowed by CORS)
FRONTEND_URL=http://localhost:3000
# Public API base, used for webhook callback URLs
API_URL=http://localhost:8000
# Where generated sites are served (path-based: {SITES_BASE_URL}/{slug})
SITES_BASE_URL=http://localhost:8000
SITES_DOMAIN=localhost:8000
SITES_BASE_PATH=./sites
# Extra comma-separated CORS origins, if any
# CORS_ORIGINS=

# Custom domains: server IP customers point their A record at, and certbot contact email
# SERVER_IP=203.0.113.10
# CERTBOT_EMAIL=admin@your-domain.com

# ------------------------------------------------------------------------------
# CELERY (Optional - for async task processing)
# ------------------------------------------------------------------------------
# Optional: If not set, tasks run synchronously (fine for testing)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# BANDWIDTH MONITORING (Optional - for Settings > Bandwidth in admin)
# ------------------------------------------------------------------------------
# Path to vnstat JSON snapshot written by cron. API reads this file for GET /api/v1/system/bandwidth.
# Cron example (every 15 min): vnstat -i eth0 --json > /var/log/webmagic/vnstat_snapshot.json
# VNSTAT_SNAPSHOT_PATH=/var/log/webmagic/vnstat_snapshot.json
# Consider snapshot stale after this many seconds (default 3600 = 1 hour)
# VNSTAT_STALE_SECONDS=3600
